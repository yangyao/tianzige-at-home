# Copy to the installed app directory as server.env and chmod 600.
# Set the actual private LAN address and an unused port; do not use the NAS admin port.
TIANZIGE_LISTEN=127.0.0.1:18086
GOMAXPROCS=1
GOMEMLIMIT=192MiB
# Without OCR configuration, original images remain available; no demo text is generated.
TIANZIGE_OCR=zai
TIANZIGE_LLM=zai
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
Z_AI_VISION_MODEL=glm-5.3-flash
# Absolute path to a private key file on the NAS, not shipped in this bundle.
Z_AI_API_KEY_FILE=
# Optional: reuse your existing OpenAI-compatible vision provider.
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=configure-locally-only
# OPENAI_MODEL=your-vision-model
